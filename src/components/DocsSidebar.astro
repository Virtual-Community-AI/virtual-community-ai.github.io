---
export interface SidebarItem {
  title: string;
  link: string;
  category?: string;
  order?: number;
}

export interface Props {
  items: SidebarItem[];
  currentSlug?: string;
}

const { items, currentSlug } = Astro.props;

// Sort items by their order
const sortedItems = items.sort((a, b) => {
  const aOrder = a.order || 999;
  const bOrder = b.order || 999;
  return aOrder - bOrder;
});

// Function to check if a link is active
const isActive = (link: string) => {
  return currentSlug === link.replace('/docs/', '');
};
---

<!-- Sidebar -->
<aside class="hidden lg:block lg:col-span-1">
  <div class="lg:sticky lg:top-24">
    <div class="bg-white border border-slate-200 rounded-lg p-6 shadow-sm">
      <h2 class="text-fluid-lg font-semibold text-slate-900 mb-4">Documentation</h2>
      
      <nav>
        <ul class="space-y-1">
          {sortedItems.map((item) => (
            <li>
              <a 
                href={item.link}                class={`block px-3 py-2 text-fluid-sm rounded-md transition-colors break-words ${
                  isActive(item.link) 
                    ? 'bg-slate-200 text-slate-900 font-medium' 
                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
                }`}
              >
                {item.title}
              </a>
              {isActive(item.link) && (
                <ul id="toc-list" class="mt-2 ml-3 space-y-1 border-l border-slate-200 pl-3"></ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</aside>

<script>
  // Build a simple hierarchical TOC (h2/h3) under the active doc link
  document.addEventListener('DOMContentLoaded', () => {
    const docsContent = document.querySelector('.docs-content');
    const tocContainer = document.getElementById('toc-list');
    if (!docsContent || !tocContainer) return;

    // Utility: create URL-friendly slug
    function slugify(text) {
      return text
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
    }

    const headings = Array.from(docsContent.querySelectorAll('h2'));
    const usedIds = new Set();

    headings.forEach((heading) => {
      const level = heading.tagName.toLowerCase();
      const text = heading.textContent?.trim() || '';
      if (!text) return;

      // Ensure the heading has a unique id
      let id = heading.getAttribute('id') || slugify(text);
      let uniqueId = id;
      let counter = 2;
      while (usedIds.has(uniqueId)) {
        uniqueId = `${id}-${counter++}`;
      }
      usedIds.add(uniqueId);
      heading.setAttribute('id', uniqueId);

      // Create list item
      const li = document.createElement('li');
      li.className = level === 'h2' ? 'text-slate-700' : 'text-slate-600 ml-3';

      const a = document.createElement('a');
      a.href = `#${uniqueId}`;
      a.textContent = text;
      a.className =
        'block px-2 py-1 text-fluid-sm rounded hover:text-slate-900 hover:bg-slate-100 transition-colors';

      li.appendChild(a);
      tocContainer.appendChild(li);
    });
  });
</script>
